              79.000000,25.000000,0
              79.022140,25.000000,0
              79.022140,25.020160,0
              79.000000,25.020160,0
              79.000000,25.000000,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
  </Document>
